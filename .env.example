# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only trusted security RPCs (spec071); never use NEXT_PUBLIC_ for this key
SUPABASE_SECRET_KEY=

# Vault session encryption — generate locally with: openssl rand -base64 32
SESSION_SECRET=

# Optional admin telemetry access: comma-separated account emails; blank disables access
ADMIN_EMAILS=
