{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.02,
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(npx shadcn@latest add:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(ls:*)",
      "Read(//**)",
      "Grep(//**)",
      "Glob(//**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "Bash(docker push:*)",
      "Bash(./scripts/build-push.sh:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.production.*)",
      "Read(.env.staging)",
      "Read(./secrets/**)",
      "Write(.env*)",
      "Edit(.env*)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.json)",
      "Write(.claude/hooks/**)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/harness.json)",
      "Edit(.claude/harness.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"Write-Output 'FYNFO GOVERNANCE ACTIVE | Read CONSTITUTION.md + AGENTS.md before acting | Spec-first: no code without approved spec in specs/** | Gates: pnpm check && pnpm test:ci && pnpm build green | Hard stops: .env*, CONSTITUTION.md, AGENTS.md, .claude/**, specs/governance/**, destructive git/docker'; Write-Output '=== CONSTITUTION (head) ==='; Get-Content CONSTITUTION.md -TotalCount 20; Write-Output '=== AGENTS (head) ==='; Get-Content AGENTS.md -TotalCount 30\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"if (-not (Test-Path 'specs')) { Write-Output 'WARN: specs/ missing — bootstrap before any impl work' }\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy RemoteSigned -File .claude/hooks/injection-guard.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy RemoteSigned -File .claude/hooks/guard-protected-paths.ps1"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy RemoteSigned -File .claude/hooks/guard-destructive-bash.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy RemoteSigned -File .claude/hooks/post-edit-tsc.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy RemoteSigned -File .claude/hooks/stop-tests.ps1"
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"Write-Output 'Done. Gates green? Spec linked? Sections cited? Scope respected? Run /next-verify before commit.'\""
          }
        ]
      }
    ]
  }
}
