{
  "name": "fynfo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:standalone": "pnpm build && cp -a .next/static .next/standalone/.next/ && cp -a public .next/standalone/",
    "start": "next start",
    "start:standalone": "node --env-file=.env.local .next/standalone/server.js",
    "prepare": "husky",
    "// quality": "",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "// testing": "",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage": "pnpm test:coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.103.0",
    "@tanstack/react-query": "5.97.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.38.0",
    "lucide-react": "0.563.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "papaparse": "5.5.3",
    "pdf-parse": "1.1.1",
    "pino": "^10.3.1",
    "radix-ui": "1.4.3",
    "react": "19.2.5",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.5",
    "react-dropzone": "14.4.1",
    "react-hook-form": "7.72.1",
    "recharts": "3.8.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "25.6.0",
    "@types/papaparse": "5.5.2",
    "@types/pdf-parse": "1.1.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.2",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,md}": "prettier --write",
    "**/*.{js,jsx,ts,tsx}": "eslint --fix --max-warnings=0"
  }
}
