# Copy this file to `.env.backup` and fill both Postgres connection strings.
# `.env.backup` is gitignored (see fynfo/.gitignore). Never commit secrets.
#
# Get connection strings from Supabase Studio:
#   Project Settings → Database → Connection string → URI (Direct connection)
#   Substitute [YOUR-PASSWORD] with the project's database password.
#
# PROD = the live fynfo project (READ FROM)
# BACKUP = the second free-tier project you created (WRITE TO)

PROD_DATABASE_URL=postgresql://postgres:REPLACE_ME@db.REPLACE_REF.supabase.co:5432/postgres
BACKUP_DATABASE_URL=postgresql://postgres:REPLACE_ME@db.REPLACE_BACKUP_REF.supabase.co:5432/postgres
